# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不要提交）
GITHUB_REPOS=deepseek-ai/deepseek-harness
CHECK_INTERVAL=600

# 飞书自定义机器人 Webhook，形如 https://open.feishu.cn/open-apis/bot/v2/hook/<token>
FEISHU_WEBHOOK=

# 飞书签名密钥（机器人安全设置开启「签名校验」后获取）
FEISHU_SECRET=

# 可选：GitHub Personal Access Token，仅需 public_repo 读权限
GITHUB_TOKEN=
